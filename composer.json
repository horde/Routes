{
    "name": "horde/routes",
    "description": "URL routing/mapping library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Routes",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Mike Naberezny",
            "email": "mike@maintainable.com",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "routing",
        "match"
    ],
    "time": "2026-06-27",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "horde/support": "^3 || dev-FRAMEWORK_6_0",
        "psr/http-message": "^2"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "horde/cache": "^3 || dev-FRAMEWORK_6_0",
        "horde/controller": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/cache": "^3 || dev-FRAMEWORK_6_0",
        "horde/controller": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Routes": "lib/"
        },
        "psr-4": {
            "Horde\\Routes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Routes\\Test\\": "test/",
            "Horde\\Routes\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}